{
  "name": "@stellar-globe/stellar-globe",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist",
    "types"
  ],
  "exports": {
    ".": {
      "import": "./dist/stellar-globe.js",
      "types": "./types/index.d.ts",
      "default": "./dist/stellar-globe.js"
    }
  },
  "main": "./dist/stellar-globe.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=./",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "typedoc": "typedoc src/index.ts",
    "test": "vitest",
    "test:noninteractive": "vitest run"
  },
  "devDependencies": {
    "@types/gzip-js": "^0.3.5",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.98.0",
    "speedscope": "^1.25.0",
    "typedoc": "^0.28.18",
    "typescript": "^5.9",
    "vite": "^6",
    "vite-plugin-dts": "^4",
    "vitest": "^2"
  },
  "dependencies": {
    "@hscmap/healpix": "^1.4.12",
    "gl-matrix": "^3.4.4",
    "gzip-js": "^0.3.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.1"
  }
}
