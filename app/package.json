{
  "name": "@stellarglobe/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "types"
  ],
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/stellar-globe-app.es.js",
      "types": "./types/index.d.ts",
      "default": "./dist/stellar-globe-app.es.js"
    }
  },
  "browser": {
    "process/browser": false
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build --base=./",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "type-check": "tsc",
    "typed-scss-module": "typed-scss-modules src -n camel",
    "make-type-validators": "typescript-json-schema -o ./devel/jsonschema/root.json --noExtraProps --required ./tsconfig.json JsonSchema && node ./devel/generate-js-type-validators.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.4",
    "@reduxjs/toolkit": "^2.0.1",
    "@stellar-globe/react-stellar-globe": "file:../react-stellar-globe",
    "@stellar-globe/stellar-globe": "file:../stellar-globe",
    "@szhsin/react-menu": "^4.1.0",
    "classnames": "^2.3.3",
    "csv-stringify": "^6.4.5",
    "material-symbols": "^0.14.3",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.12",
    "react-redux": "^9.0.4",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^9.2.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.2.5",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/react-transition-group": "^4.4.10",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitejs/plugin-react": "^4.2.1",
    "ajv": "^8.12.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fast-json-patch": "^3.1.1",
    "jsdom": "^23.0.1",
    "rollup-plugin-visualizer": "^5.11.0",
    "sass": "^1.69.5",
    "typed-scss-modules": "^8.0.0",
    "typescript": "^5.3.3",
    "typescript-json-schema": "^0.62.0",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  }
}