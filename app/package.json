{
  "name": "@stellar-globe/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "types",
    "src"
  ],
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/app.es.js",
      "types": "./types/index.d.ts",
      "default": "./dist/app.es.js"
    },
    "./commTools": {
      "import": "./dist/commTools.es.js",
      "types": "./types/commTools/index.d.ts",
      "default": "./dist/commTools.es.js"
    }
  },
  "browser": {
    "process/browser": false
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build --base=./",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "type-check": "tsc",
    "typed-scss-module": "typed-scss-modules src -n camel",
    "refresh-types": "npm run make-public-json-schema && npm run make-persistent-typevalidator && npm run make-toapp-typevalidator  && npm run make-action-typevalidator",
    "make-toapp-typevalidator": "node ./node_modules/@stellar-globe/typescript-typevalidator/dist/cli.js -o ./src/commTools/toAppTypeValidation -t ToAppValidatorJsonSchema",
    "make-action-typevalidator": "node ./node_modules/@stellar-globe/typescript-typevalidator/dist/cli.js -o ./src/commTools/actionTypeValidation -t ActionValidatorJsonSchema",
    "make-public-json-schema": "typescript-json-schema -o ./jsonschema/public.json --noExtraProps --required ./tsconfig.json PublicJsonSchema"
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.9",
    "@reduxjs/toolkit": "^2.1.1",
    "@stellar-globe/react-draggable-dialog": "file:../react-draggable-dialog",
    "@stellar-globe/react-stellar-globe": "file:../react-stellar-globe",
    "@stellar-globe/stellar-globe": "file:../stellar-globe",
    "@szhsin/react-menu": "^4.1.0",
    "classnames": "^2.5.1",
    "csv-stringify": "^6.4.6",
    "material-symbols": "^0.16.0",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.13",
    "react-redux": "^9.1.0",
    "react-transition-group": "^4.4.5",
    "use-immer": "^0.9.0"
  },
  "devDependencies": {
    "@stellar-globe/typescript-typevalidator": "file:../typescript-typevalidator",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@types/react-transition-group": "^4.4.10",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fast-json-patch": "^3.1.1",
    "jsdom": "^24.0.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.70.1",
    "typed-scss-modules": "^8.0.0",
    "typescript": "^5.3.3",
    "typescript-json-schema": "^0.63.0",
    "vite": "^5.1.4",
    "vitest": "^1.3.1"
  },
  "typesVersions": {
    "*": {
      "commTools": [
        "./types/commTools/index.d.ts"
      ]
    }
  }
}
