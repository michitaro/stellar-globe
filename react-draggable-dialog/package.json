{
  "name": "@stellar-globe/react-draggable-dialog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "types"
  ],
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/react-draggable-dialog.es.js",
      "types": "./types/index.d.ts",
      "default": "./dist/react-draggable-dialog.es.es.js"
    },
    "./style.css": {
      "default": "./dist/react-draggable-dialog.css"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --base=./",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:noninteractive": "vitest run",
    "typed-scss-module": "typed-scss-modules src -n camel",
    "typedoc": "typedoc src/index.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "classnames": "^2.5.1",
    "react-transition-group": "^4.4.5"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^27.4.0",
    "sass": "^1.98.0",
    "typed-scss-modules": "^8.1.1",
    "typedoc": "^0.28.18",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9"
  }
}
